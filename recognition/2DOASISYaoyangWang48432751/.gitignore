## ======================================
## COMP3710: Rangpur Project .gitignore
## ======================================

# --------------------------------------
# 🧠 Datasets and raw data (never commit)
# --------------------------------------
data/
datasets/
*.csv
*.tsv
*.json
*.zip
*.tar
*.gz
*.nii
*.nii.gz

# --------------------------------------
# 🧩 Model weights and checkpoints
# --------------------------------------
models/
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.pkl
*.npz
*.npy

# --------------------------------------
# 🧾 Logs and runtime artifacts
# --------------------------------------
__pycache__/
*.log
*.tmp
*.out
*.err
outputs/
runs/
wandb/
*.ipynb_checkpoints/

# --------------------------------------
# 🖼️ Figures and visualizations
# (Keep specific ones for README)
# --------------------------------------
predictions_viz/
figs_loss_curve.png
figs_dice_curve.png
!README_figs/
README_figs/*

# --------------------------------------
# 🧰 Environment and IDE files
# --------------------------------------
.vscode/
.idea/
.DS_Store
*.swp
.env
*.bak

# --------------------------------------
# 🧪 Jupyter and notebooks (optional)
# --------------------------------------
*.ipynb
